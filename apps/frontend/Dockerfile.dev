FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies including PostCSS and Tailwind
RUN npm install

# Ensure PostCSS and Tailwind are available
RUN npm install tailwindcss autoprefixer postcss

# Copy source code
COPY . .

# Expose port
EXPOSE 3005

# Start development server
CMD ["npm", "run", "dev"]
